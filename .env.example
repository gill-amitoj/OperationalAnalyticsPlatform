# Copy to .env and fill in. .env is gitignored — never commit it.

# Optional: Socrata app token (raises API rate limits; not required for these small datasets)
# Create one at https://data.edmonton.ca/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# BigQuery (optional — the pipeline falls back to local DuckDB when unset)
GCP_PROJECT_ID=
BQ_DATASET=edmonton_traffic_safety
BQ_LOCATION=northamerica-northeast1
# Path to a service-account JSON key stored OUTSIDE this repo, or leave blank to use
# `gcloud auth application-default login` credentials.
GOOGLE_APPLICATION_CREDENTIALS=
